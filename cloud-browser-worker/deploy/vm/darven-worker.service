[Unit]
Description=Darven v101 cloud browser worker and Render snapshot pusher
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=/etc/darven-worker/release.env
ExecStartPre=-/usr/bin/docker rm -f darven-worker
ExecStart=/usr/bin/docker run --name darven-worker --network host --shm-size=1g --env-file /etc/darven-worker/worker.env -v /var/lib/darven-worker:/app/data --entrypoint /bin/sh ${WORKER_IMAGE} -c "Xvfb :99 -screen 0 1440x1000x24 -nolisten tcp >/tmp/xvfb.log 2>&1 & sleep 2; export DISPLAY=:99; exec npm start"
ExecStop=/usr/bin/docker stop -t 30 darven-worker
ExecStopPost=-/usr/bin/docker rm -f darven-worker
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
