{
  "releaseName": "v105抓牌Outbox服務不中斷修正版1",
  "releaseVersion": "v105-outbox-service-continuity.1",
  "gitTag": "v105-outbox-service-continuity.1",
  "applicationVersion": "1.0.17",
  "baseCommit": "7ec78bed6b7f87f12d40d1714373dc40736f72b6",
  "strategyVersion": "v105",
