  "behavior": {
    "outboxClaimLimit": 1,
    "eventLoopYieldBetweenRows": true,
    "formalIdentityConcurrency": 1,
    "eventLoopYieldBetweenIdentities": true,
    "predictionRulesChanged": false,
    "predictionWeightsChanged": false,
    "settlementSemanticsChanged": false
  },
  "deploymentOrder": [
    "proxy-render-exact-commit",
    "worker-vm-exact-commit",
    "frontend-pages-exact-commit",
    "watchdog-health-readback",
    "live-five-minute-e2e"
  ],
  "rollback": {
    "targetTag": "v105-capture-liveness.1",
    "preserveQueueCursorJournal": true,
    "preserveOutboxHistory": true,
    "requireUnfinishedOutboxZeroBeforeConsumerRollback": true
  }
}
