{
  "releaseName": "v105影子多桌服務率修正版1",
  "releaseVersion": "v105-shadow-table-concurrency.1",
  "gitTag": "v105-shadow-table-concurrency.1",
  "applicationVersion": "1.0.21",
  "baseRelease": "v1.0.20",
  "strategyVersion": "v105",
  "protocolVersion": "v105",
  "databaseMigrationRequired": false,
  "behavior": {
    "formalSettlementConcurrency": 1,
    "serviceWorkConcurrency": 1,
    "shadowWorkConcurrency": 1,
    "formalAckWaitsForShadow": false,
    "retainFinalBehindTimedOutShadowWork": true,
    "priorityBurstLimit": 4,
    "shadowServiceWorkTimeoutMs": 2000,
    "shadowShutdownDeadlineMs": 5000,
    "outboxCompletionWaitsForShadowDrain": true,
    "permanentHangRetainedByDurableOutbox": true,
    "shadowIsolation": "child_process_fork",
    "oneIpcBatchPerOutboxLease": true,
    "killChildOnTimeoutOrAbort": true,
    "secretsOverIpc": false,
    "childEnvironmentAllowlist": true,
    "exactLeaseAbsoluteDeadlineFence": true,
    "childExitConfirmedBeforeLeaseFailure": true,
    "formalEnrichedTablesSentToChild": true,
    "formalRankLedgerBatchHydration": true,
    "formalSnapshotFifo": true,
    "underlyingLeasePhaseSettledBeforeFailureAck": true,
    "failureAckAttempts": 1,
    "unconfirmedChildTermination": "fatal_process_exit_70",
    "hydrationBeforeOutboxClaim": true,
    "hydrationConcurrency": "enabled_runtimes",
    "captureConcurrency": "per_item_across_runtimes",
    "shadowCrossTableConcurrency": "bounded_by_table_identity",
    "shadowMaxConcurrentRuntimeOperations": 9,
    "shadowSameTablePayloadOrder": "sequential",
    "exactNoIssuanceOnly": true,
    "schedulerRejectsAfterClosing": true,
    "staleIssuanceReconcilesLatest": true,
    "coalesceLatestTableObservation": true,
    "waitForServiceWorkOnShutdown": true,
    "rejectStaleScreenIssuance": true,
    "predictionRulesChanged": false,
    "predictionWeightsChanged": false,
    "settlementSemanticsChanged": false
  },
  "deploymentOrder": [
    "proxy-render-exact-commit",
    "outbox-live-drain",
    "watchdog-health-readback",
    "live-five-minute-e2e"
  ],
  "rollback": {
    "targetTag": "v1.0.20",
    "preserveQueueCursorJournal": true,
    "preserveOutboxHistory": true,
    "requireUnfinishedOutboxZeroBeforeRollback": true
  }
}
