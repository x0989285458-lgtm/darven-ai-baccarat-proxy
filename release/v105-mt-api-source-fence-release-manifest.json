  "rollback": {
    "target": {
      "commit": "b1cd90d2bdb0cc1bea38f63066002eef62136bcd",
      "tree": "55357e0ffc0133413690083ad976a86d7e251015",
      "proxyArtifact": "proxy-from-exact-target",
      "browserWorkerArtifact": "cloud-browser-worker-from-exact-target"
    },
    "order": [
      {
        "id": "stop-api-intake-sockets-renewal",
        "requireApiIntakeStopped": true,
        "requireRenewalTimerStopped": true,
        "requireStopAcknowledgement": true
      },
      {
        "id": "drain-pusher-queue",
        "requireDrainComplete": true,
        "unfinishedCounts": [
          "pending",
          "processing",
          "error",
          "dead-letter"
        ]
      },
      {
        "id": "stop-pusher-and-wait",
        "requirePusherStopped": true,
        "requireInFlight": 0,
        "abortAfterTimeoutRequired": true
      },
      {
        "id": "checkpoint-queue-cursor-journal",
        "checkpoint": [
          "queue",
          "cursor",
          "journal"
        ],
        "requireChecksums": true,
        "requireCursorBaseline": true
      },
      {
        "id": "readback-zero-and-preserved",
        "requireAllUnfinishedCountsZero": true,
        "requireCheckpointReadback": true,
        "requireCursorNonRegression": true,
        "abortBeforeArtifactRollbackOnFailure": true
      },
      {
        "id": "disable-fenced-requirement",
        "setEnvironment": "REQUIRE_FENCED_INGEST=false",
        "requireEnvironmentReadback": "false"
      },
      {
        "id": "readback-old-unfenced-accepted",
        "requireOldUnfencedAccepted": true,
        "abortBeforeProxyRollbackOnFailure": true
      },
      {
        "id": "disable-v9-shadow-before-proxy-rollback",
        "setEnvironment": "V105_SHADOW_V9_ENABLED=false",
        "requireEnvironmentReadback": "false",
        "preserveShadowEvidence": true,
        "abortBeforeProxyRollbackOnFailure": true
      },
      {
        "id": "rollback-proxy-compatible",
        "artifact": "proxy-from-exact-target",
        "requireCompatibleStatusReadback": true
      },
      {
        "id": "readback-lease-stopped-no-socket",
        "requireLeaseStopped": true,
        "requireApiSocketCount": 0
      },
      {
        "id": "start-old-browser-worker",
        "artifact": "cloud-browser-worker-from-exact-target",
        "requireBrowserOwnerReadback": true
      }
    ],
    "preserve": [
      "queue",
      "cursor",
      "journal"
    ],
    "requireAllUnfinishedCountsZero": true,
    "unfinishedCounts": [
      "pending",
      "processing",
      "error",
      "dead-letter"
    ],
    "requireNoNewLostFinals": true,
    "requireCursorNonRegression": true,
    "requireProducerQuiesce": true,
    "abortGates": [
      "rollback-target-readback-mismatch",
      "unfinished-count-nonzero",
      "producer-not-quiesced",
      "drain-checkpoint-readback-failed",
      "old-unfenced-not-accepted",
      "proxy-compatibility-readback-failed",
      "api-owner-lease-not-stopped",
      "api-owner-socket-still-open",
      "queue-cursor-journal-preservation-failed",
      "new-lost-final-detected",
      "cursor-regression-detected",
      "v9-shadow-disable-readback-failed"
    ],
    "preserveShadowEvidence": true,
    "requireV9ShadowDisabledBeforeProxyRollback": true
  },
  "behavior": {
    "predictionRulesChanged": false,
    "predictionWeightsChanged": false,
    "predictionThresholdsChanged": false,
    "uiChanged": false,
    "v6ToV9Changed": false,
    "versionChanged": true
  },
  "shadowHydrationHotfix": {
    "strategyVersion": "v105-shadow-v9-weighted-v7-v8",
    "runtimeFlag": "V105_SHADOW_V9_ENABLED=true",
    "preservesFormalV105": true,
    "preservesShadowHistory": true,
    "changesWeightsOrThresholds": false,
    "nodeDateMillisecondOrdering": true
  }
}
