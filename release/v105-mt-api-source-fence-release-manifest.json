    },
    "attestation": {
      "externalFileRequired": true,
      "immutableCommitAndAnnotatedTagRequired": true,
      "imageDigestReadbackRequired": true,
      "phase": "post-build-pre-cutover",
      "independentBuildReceiptsRequired": true,
      "fixedRegistryAdapterRequired": true,
      "fixedRegistryAdapter": "scripts/trusted-registry-readback-adapter.mjs",
      "arbitraryReadbackJsonRejected": true,
      "abortOnMismatch": true
    },
    "shadowHydrationMigration": {
      "algorithm": "sha256",
      "path": "supabase/migrations/20260801162200_v105_shadow_v9_hydration_millisecond_order.sql",
      "sha256": "1532547446c46a94373f1b4758f1b464798b3d5583f4a73492c83000a662a974"
