      "sha256": "aa4730458d093c08275eaa4c0d3e9b87b2088de3da9b302890615edf0b7dbc89"
    },
    "proxyBuildInput": {
      "algorithm": "sha256",
      "paths": [
        "proxy/package.json",
        "proxy/package-lock.json",
        "proxy/deploy/render.yaml",
        "proxy/src",
        "shared"
      ],
      "excludedPaths": [],
      "sha256": "27ece958274d7bfff6c4a7a0a1502a735b4413de7d17845579b111a8793684bd"
    },
    "workerBuildInput": {
      "algorithm": "sha256",
      "paths": [
        "cloud-browser-worker/.dockerignore",
        "cloud-browser-worker/Dockerfile",
        "cloud-browser-worker/package.json",
        "cloud-browser-worker/package-lock.json",
        "cloud-browser-worker/src",
